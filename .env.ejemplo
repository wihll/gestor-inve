# Copiar a `.env` y **generar** cada valor. `.env` está en `.gitignore` y no debe subirse.
#
#   POSTGRES_CLAVE=$(openssl rand -base64 32)
#   GESTORINVE_CLAVE_BD=$(openssl rand -base64 32)
#   JWT_CLAVE=$(openssl rand -base64 48)
#
# JWT_CLAVE firma los tokens con HMAC-SHA256: necesita al menos 32 bytes de aleatoriedad real
# y **no se reutiliza entre instalaciones**. Dos instalaciones con la misma clave aceptan
# mutuamente los tokens de la otra, así que un usuario de una podría operar en la otra.
# Cambiarla invalida todas las sesiones vivas, que es exactamente lo que se quiere si se filtró.

POSTGRES_CLAVE=
GESTORINVE_CLAVE_BD=
JWT_CLAVE=

# Puerto del anfitrión donde queda la web. La Api no publica puerto a propósito.
PUERTO_WEB=8080
